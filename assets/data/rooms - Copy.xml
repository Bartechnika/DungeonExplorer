					you take your rucksack off the hook and remember to pocket your ID card.
				</dialogue>
				<item name="" id="#001" amount="1"></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>

		<location name="door" adj="hook:true">
			<description></description>
			<dialogue></dialogue>
			<interaction name="" type="dialogue">
				<dialogue>
					cya later room :) OH i forgot to turn off my lights...
				</dialogue>
				<item name="" id="#000" amount=""></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>
	</bedroom>

	<car>
		<name>
			Car journey
		</name>
		<description>
			A leisurely ride the train station through the apocalyptic utopia of Autodale.
		</description>
		<entranceDialogue>
			you hop in the passenger seat, rucksack in hand.
		</entranceDialogue>
		<exitDialogue>
			See you later! x
		</exitDialogue>
		<next>train-platform</next>

		<location name="seat" adj="turn-around:true">
			<description></description>
			<dialogue></dialogue>
			<interaction name="" type="dialogue">
				<dialogue>
					*road works again?*
				</dialogue>
				<item name="" id="#000" amount=""></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>

		<location name="turn-around" adj="seat:true">
			<description></description>
			<dialogue></dialogue>
			<interaction name="" type="found-item">
				<dialogue>
					you look behind you to see Octopus sitting lonely on the backseat
				</dialogue>
				<item name="" id="#002" amount="1"></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>
	</car>

	<train-platform>
		<name>
			Train platform
		</name>
		<description>
			A small train platform in a local village commonly frequented by college students.
		</description>
		<entranceDialogue>
			I arrived early enough - right?
		</entranceDialogue>
		<next>car</next>

		<location name="entrance" adj="platform:true">
			<description></description>
			<dialogue>Welcome to Hawkins Station.</dialogue>
			<interaction name="" type="dialogue">
				<dialogue>
					*you look at the train times to your left*
				</dialogue>
				<item name="" id="#000" amount="0"></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>

		<location name="platform" adj="entrance:true">
			<description></description>
			<dialogue>Waaaah waaaah waaaaah!!! TOOT TOOT</dialogue>
			<interaction name="" type="dialogue">
				<dialogue>
					you look at the bus stop pole and see a sticker
				</dialogue>
				<item name="" id="#000" amount="0"></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>

		<exitDialogue>
			You get back in the car after a long day.
		</exitDialogue>
	</train-platform>

