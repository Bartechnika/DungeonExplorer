	<bathroom>
		<name>
			Bathroom
		</name>
		<description>
			A small bathroom with a shower to the left.
			Toiletries sat idling in cups stacked along the window sill.
		</description>
		<entranceDialogue>
			You trudge into the bathroom half-awake and make your way to the cabinet.
		</entranceDialogue>
		<exitDialogue>
			You hastily leave the room, tap still running.
		</exitDialogue>
		<next>bedroom</next>

		<location name="bathroom-mirror" adj="sink:true">
			<description>A clean bathroom mirror</description>
			<dialogue></dialogue>
			<interaction name="Good look" type="mirror">
				<dialogue>
					*you stare at yourself in the shiny mirror under good lighting*
					Tip: you can only see your stats when looking into a reflective surface.
				</dialogue>
				<item name="" id="#000" amount="0"></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>

		<location name="cabinet" adj="sink:true,bathroom-door:false">
			<description></description>
			<dialogue></dialogue>
			<interaction name="" type="dialogue">
				<dialogue>
					*you reach out to grab your toothbrush*
				</dialogue>
				<item name="" id="#000" amount="0"></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>

		<location name="sink" adj="bathroom-door:false">
			<description></description>
			<dialogue></dialogue>
			<interaction name="" type="fight-monster">
				<dialogue>
					Fighting increases your resilience - you can't flee forever.
				</dialogue>
				<item name="" id="#000" amount="0"></item>
				<monster name="Water Conjuror" id="#001" of=""></monster>
			</interaction>
		</location>

		<location name="bathroom-door" adj="sink:true">
			<description></description>
			<dialogue></dialogue>
			<interaction name="" type="dialogue">
				<dialogue>
					You turn to leave
				</dialogue>
				<item name="" id="#000" amount=""></item>
				<monster name="" id="#000" of=""></monster>
			</interaction>
		</location>
	</bathroom>

	<bedroom>
		<name>
			Your bedroom
		</name>
		<description>
			Your safe place - nothing can hurt you here. Equipped with beautiful hanging lights and posters from your favourite Anime.
		</description>
		<entranceDialogue>
			Time to get sorted for the day.
		</entranceDialogue>
		<exitDialogue>
			all ready for the day.
		</exitDialogue>
		<next>car</next>

		<location name="hook" adj="door:true">
			<description></description>
			<dialogue></dialogue>
			<interaction name="" type="found-item">
